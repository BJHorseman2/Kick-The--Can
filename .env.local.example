# ---------------------------------------------------------------------------
# Sky Heist environment variables
#
# 1. Copy this file to ".env.local"  ->  cp .env.local.example .env.local
# 2. Paste your real keys below.
# 3. Restart `npm run dev` after any change (Next only reads env at boot).
# ---------------------------------------------------------------------------

# REQUIRED — Google Maps Platform API key with the "Map Tiles API" enabled.
# This is exposed to the browser (Cesium fetches the 3D Tiles client-side),
# so it MUST be NEXT_PUBLIC_*. Lock it down in Google Cloud Console with an
# HTTP-referrer restriction + the Map Tiles API restriction (see README).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OPTIONAL — Cesium ion access token. Not required for this game (we hide the
# default globe and stream only Google's tiles), but setting it silences
# Cesium's default-token console warning if you see one.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
